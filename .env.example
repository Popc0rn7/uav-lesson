# PC 场景 ELF：不是 .sh、源码目录或 settings.json。
# 相对路径以仓库根目录为基准；支持 ~，空格路径加引号。
# 保留完整 Unreal 包资源，布局为 <包根>/<项目>/Binaries/Linux/<ELF>。
# settings 由各阶段独立维护，不从场景包读取。
AIRSIM_NH=/path/to/AirSimNH/LinuxNoEditor/AirSimNH/Binaries/Linux/AirSimNH
AIRSIM_TOWN05=/path/to/Town05/LinuxNoEditor/CarlaUE4/Binaries/Linux/CarlaUE4
AIRSIM_RACE=/path/to/ADRL/ADRL/Binaries/Linux/ADRL

# Stage 3：AeroVLA 推理服务完整端点（服务需单独启动）。
AEROVLA_API_URL=http://127.0.0.1:8000/infer
AEROVLA_API_TIMEOUT_S=30

# Stage 5：DINO 服务完整端点。
DINO_DETECT_URL=http://127.0.0.1:18008/detect

# Stage 5：Qwen 大脑和 Jev 小脑
QWEN_BASE_URL=https://llm-j5aket8kum7ehutn.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_API_KEY=<your-api-key>

# typesafe：原生 System One；vllm：JEV-9B System 1，非 Chat Completions。
JEV_BACKEND=typesafe
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_API_KEY=
