# PC 场景 ELF：不是 .sh、源码目录或 settings.json。
# 相对路径以仓库根目录为基准；支持 ~，空格路径加引号。
# 保留完整 Unreal 包资源，布局为 <包根>/<项目>/Binaries/Linux/<ELF>。
# 前三种场景的 settings 由各阶段独立维护；Stage 5 使用已验收包内的 settings。
AIRSIM_NH=/path/to/AirSimNH/LinuxNoEditor/AirSimNH/Binaries/Linux/AirSimNH
AIRSIM_TOWN05=/path/to/Town05/LinuxNoEditor/CarlaUE4/Binaries/Linux/CarlaUE4
AIRSIM_RACE=/path/to/ADRL/ADRL/Binaries/Linux/ADRL

# Stage 5：已验收的 AirSim_Mountains Shipping 包，填写 ELF 完整路径。
# 包内保留 Config/AirSim/settings.json、Saved/SaveGames 三车路线和全部资源。
AIRSIM_MOUNTAINS=/path/to/AirSim_Mountains/LinuxNoEditor/demo/Binaries/Linux/demo-Linux-Shipping

# Stage 3：AeroVLA 推理服务完整端点（服务需单独启动）。
AEROVLA_API_URL=http://127.0.0.1:8000/infer
AEROVLA_API_TIMEOUT_S=30

# Stage 5：DINO 服务完整端点。
DINO_DETECT_URL=http://127.0.0.1:8000/detect
DINO_MIN_SCORE=0.7

# Stage 5：Qwen 大脑和 Jev 小脑
QWEN_BASE_URL=https://llm-j5aket8kum7ehutn.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_API_KEY=

# typesafe：原生 System One；vllm：JEV-9B System 1，非 Chat Completions。
JEV_BACKEND=vllm
JEV_BASE_URL=http://127.0.0.1:18081/v1
JEV_MODEL=jev-decision
JEV_API_KEY=
JEV_DECISION_HEAD=/path/to/JEV-9B/adapter_vllm/decision_head.json
JEV_CALIBRATION=/path/to/JEV-9B/calibration.json

# 云端服务需要代理时显式填写；本机RPC和DINO不使用这些代理。
# JEV_PROXY=http://127.0.0.1:7890
# QWEN_PROXY=http://127.0.0.1:7890

OPENROUTER_API_KEY=<your-api-key>
TYPESAFE_API_KEY=<your-api-key>
# RoboPi 本板 HTTP 服务端口；PC HDC 映射可另选本地端口。
QWEN_PORT=8080
DINO_PORT=8083
AEROVLA_PORT=8084

# PC 本机路径：相对路径以仓库根为基准；环境变量优先。
OHOS_TOOLCHAINS_DIR=/path/to/ohos-sdk/linux/toolchains-linux-x64-26.x/toolchains
OHOS_SDK=/path/to/extracted/native
TCIM_RUNTIME_PATH=houmo/deps/tcim
HOUMO_MODELZOO_ROOT=houmo/deps/modelzoo
BOARD_WORK_DIR=.board-work
OHOS_HOST_PYTHON=/path/to/board-host-venv/bin/python
