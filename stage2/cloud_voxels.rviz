Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 18; 24; 34
    Fixed Frame: stage2_depth
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 70; 80; 95
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Axes
      Name: Sensor axes
      Enabled: true
      Length: 1
      Radius: 0.03
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Marker
      Name: Surface voxels (single frame)
      Enabled: true
      Topic:
        Value: /stage2/depth/voxels
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Queue Size: 2
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 18
      Pitch: 0.45
      Yaw: 2.6
      Focal Point:
        X: 6
        Y: 0
        Z: 0
      Target Frame: <Fixed Frame>
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
Window Geometry:
  Width: 850
  Height: 650
