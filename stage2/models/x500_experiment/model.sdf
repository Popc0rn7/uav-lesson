<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="x500_experiment">
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <include merge="true">
      <uri>model://mid360s</uri>
      <pose relative_to="base_link">0 0 0.10 0 0 0</pose>
    </include>
    <joint name="Mid360sJoint" type="fixed">
      <parent>base_link</parent>
      <child>mid360s_link</child>
      <pose relative_to="mid360s_link">0 0 0 0 0 0</pose>
    </joint>
    <link name="camera_link">
      <!--Orbbec Gemini 2 尺寸/质量与低分辨率模式近似；理想共光心，不是实机外参或双目误差模型。-->
      <pose relative_to="base_link">0.17 0 0.025 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>.098</mass>
        <inertia>
          <ixx>7.125416666666667e-05</ixx>
          <iyy>1.2454166666666668e-05</iyy>
          <izz>7.35e-05</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.030 0.090 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.12 0.15 1</ambient>
          <diffuse>0.1 0.12 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="camera_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.030 0.090 0.025</size>
          </box>
        </geometry>
      </collision>
      <sensor name="orbbec_rgb" type="camera">
        <gz_frame_id>orbbec_sensor</gz_frame_id>
        <pose>0.016 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.5009831567151235</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>.15</near>
            <far>100</far>
          </clip>
        </camera>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
      </sensor>
      <sensor name="orbbec_depth" type="depth_camera">
        <gz_frame_id>orbbec_sensor</gz_frame_id>
        <pose>0.016 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.5882496193148399</horizontal_fov>
          <image>
            <width>640</width>
            <height>400</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>.15</near>
            <far>20</far>
          </clip>
        </camera>
        <topic>depth_camera</topic>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
      </sensor>
    </link>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
    </joint>
  </model>
</sdf>
