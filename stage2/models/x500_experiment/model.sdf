<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="x500_experiment">
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <include merge="true">
      <uri>model://mid360s</uri>
      <pose relative_to="base_link">0 0 0.10 0 0 0</pose>
    </include>
    <joint name="Mid360sJoint" type="fixed">
      <parent>base_link</parent>
      <child>mid360s_link</child>
      <pose relative_to="mid360s_link">0 0 0 0 0 0</pose>
    </joint>
    <link name="camera_link">
      <pose relative_to="base_link">0.12 0.03 0.002 0 0 0</pose>
      <inertial>
        <pose>0.00358 -0.03 0.014 0 0 0</pose>
        <mass>0.061</mass>
        <inertia>
          <ixx>0.0000460804</ixx>
          <iyy>0.0000055421</iyy>
          <izz>0.0000436519</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <mesh>
            <uri>model://OakD-Lite/meshes/OakDLite.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="camera_collision">
        <pose>0.00358 -0.03 0.014 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0175 0.091 0.028</size>
          </box>
        </geometry>
      </collision>
      <sensor name="IMX214" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0.01233 -0.03 0.01878 0 0 0</pose>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
      </sensor>
      <sensor name="StereoOV7251" type="depth_camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0.01233 -0.03 0.01878 0 0 0</pose>
        <camera>
          <horizontal_fov>1.274</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>19.1</far>
          </clip>
        </camera>
        <topic>depth_camera</topic>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
      </sensor>
    </link>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
    </joint>
  </model>
</sdf>
