if(NOT DEFINED ENV{OHOS_SDK_NATIVE} OR NOT DEFINED ENV{UAV_BOARD_DEPS})
  message(FATAL_ERROR "Set OHOS_SDK_NATIVE and UAV_BOARD_DEPS")
endif()
set(OHOS_ARCH arm64-v8a CACHE STRING "" FORCE)
set(OHOS_STL c++_shared CACHE STRING "" FORCE)
include("$ENV{OHOS_SDK_NATIVE}/build/cmake/ohos.toolchain.cmake")
list(APPEND CMAKE_FIND_ROOT_PATH "$ENV{UAV_BOARD_DEPS}/install" "$ENV{UAV_BOARD_DEPS}/out" "$ENV{UAV_BOARD_OVERLAY}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
