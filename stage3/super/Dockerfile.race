FROM uav-computer-ros-humble:local
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglew-dev libglfw3-dev xvfb xauth mesa-utils \
    && rm -rf /var/lib/apt/lists/*
ENV ROS_DOMAIN_ID=13 LIBGL_ALWAYS_SOFTWARE=1
ENTRYPOINT ["/bin/bash", "/lesson/stage3/super/run_super_race.sh"]
