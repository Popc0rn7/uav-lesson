# PC：复制为 stage5/.env；环境变量优先于文件。无需 API key。
DINO_DETECT_URL=http://127.0.0.1:18008/detect
DINO_TEXT="a person. a car."
DINO_TIMEOUT=60
STAGE5_RGB_URL=http://127.0.0.1:8189/rgb
STAGE5_DEPTH_URL=http://127.0.0.1:8189/depth
RGBD_MAX_SKEW_S=0.05
RGBD_MAX_AGE_S=0.5
VOXEL_SIZE_M=0.25
VOXEL_PIXEL_STRIDE=8

# Jev：从 jev-drone 配置导入真实密钥到忽略的 .env，不提交密钥。
TYPESAFE_API_KEY=
# 可选：显式指定已有的可用代理，避免依赖启动终端的代理环境。
# JEV_PROXY=http://127.0.0.1:7897
JEV_MODEL=jev-latest
JEV_CALL_HZ=1
JEV_CALL_BUDGET=10
JEV_TIMEOUT=10
JEV_STALE_AFTER_S=1.5
JEV_RETRY_BASE_S=1
JEV_MAX_CONSECUTIVE_ERRORS=3

# Qwen VLM：OpenAI 兼容 Chat Completions，BASE_URL 包含 /v1（如服务需要）。
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_API_KEY=
QWEN_TIMEOUT=60
QWEN_SUMMARY_TIMEOUT=30
# Qwen 默认直连，不继承 HTTP(S)_PROXY/ALL_PROXY；仅显式设置此项时使用代理。
QWEN_PROXY=

# Stage 5 mission 红车 demo 的 DINO 候选置信度下限（不替代 RGBD 确认）。
DINO_MIN_SCORE=0.35
